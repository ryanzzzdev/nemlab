# Copy to .env and configure locally; never commit the real key.
# Shared by the API, worker, prices CLI and docker compose — each process
# reads only the variables it knows. Nothing loads this file implicitly:
# export it (set -a; . ./.env; set +a) or configure it in the IDE.

# Worker only — passed to the price-fetch child process.
OPEN_ELECTRICITY_API_KEY=

# Shared: API (enabled features only), worker and prices CLI.
# docker compose reads NEMLAB_DB_PASSWORD for POSTGRES_PASSWORD.
NEMLAB_DB_URL=jdbc:postgresql://127.0.0.1:55432/nemlab
NEMLAB_DB_USER=nemlab
NEMLAB_DB_PASSWORD=

# Worker only — price-refresh polling/scheduling; migrate the database first.
NEMLAB_WORKER_ENABLED=false
NEMLAB_WORKER_SCHEDULE_ENABLED=false
NEMLAB_WORKER_REGIONS=NSW1
NEMLAB_WORKER_POLL_MS=5000

# Worker only — simulation execution; requires migrated database, no OE key.
NEMLAB_SIMULATION_ENABLED=false
NEMLAB_SIMULATION_POLL_MS=5000

# Worker: bounded GridReplay imports (demand/flows/fueltech power).
# Requires OPEN_ELECTRICITY_API_KEY like refresh polling.
NEMLAB_GRID_IMPORT_ENABLED=false
NEMLAB_GRID_IMPORT_POLL_MS=5000

# API only — protected operator endpoints; separate from the OE credential.
NEMLAB_ADMIN_ENABLED=true
NEMLAB_ADMIN_OPERATOR=
NEMLAB_ADMIN_TOKEN=
NEMLAB_ADMIN_BASE_URL=http://127.0.0.1:5274/admin

# API only — public stored-price reads; database required, no OE/operator credential.
NEMLAB_DATA_ENABLED=false

# API only — public simulation lifecycle; independent of worker polling/price reads.
NEMLAB_SIMULATION_API_ENABLED=false
