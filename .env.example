# Copy to .env and configure locally; never commit the real key.
OPEN_ELECTRICITY_API_KEY=

# Local database; choose a password before starting Compose.
NEMLAB_DB_URL=jdbc:postgresql://127.0.0.1:55432/nemlab
NEMLAB_DB_USER=nemlab
NEMLAB_DB_PASSWORD=

# Worker execution is opt-in; migrate the database before enabling.
NEMLAB_WORKER_ENABLED=false
NEMLAB_WORKER_SCHEDULE_ENABLED=false
NEMLAB_WORKER_REGIONS=NSW1
NEMLAB_WORKER_POLL_MS=5000
